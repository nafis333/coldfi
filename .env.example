# Database (must be a valid postgres:// connection string)
DATABASE_URL=postgres://postgres:changeme@localhost:5432/coldfi
DB_PASSWORD=changeme
DB_USER=coldfi
DB_NAME=coldfi

# JWT
JWT_SECRET=generate-a-random-64-char-secret-here-at-least-32-chars!!
COOKIE_SECRET=another-random-64-char-secret-here-at-least-32-chars!!

# JWT expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated origins for development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Rate limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Admin
ADMIN_ENABLED=false
ADMIN_PORT=3002

# Crypto
PBKDF2_ITERATIONS=600000

# File uploads
MAX_RECEIPT_SIZE_MB=5

# VAPID (generate via: npm run generate-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@coldfi.app

# Domains (for nginx — only used in production)
API_DOMAIN=api.coldfi.example.com
ADMIN_DOMAIN=coldfi.example.com
