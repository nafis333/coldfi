# Database (Supabase — use Direct connection, port 5432)
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:changeme@db.<project-ref>.supabase.co:5432/postgres

# Redis (Upstash — use rediss:// for TLS)
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=rediss://default:changeme@example.upstash.io:6379

# JWT
JWT_SECRET=generate-a-random-64-char-secret-here-at-least-32-chars!!
COOKIE_SECRET=another-random-64-char-secret-here-at-least-32-chars!!

# JWT expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# CORS (comma-separated origins for development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Rate limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Admin
ADMIN_ENABLED=false
ADMIN_PORT=3002

# Crypto
PBKDF2_ITERATIONS=600000

# File uploads
MAX_RECEIPT_SIZE_MB=5

# VAPID (generate via: npm run generate-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@coldfi.app

# Domains (for nginx — only used in production)
API_DOMAIN=api.coldfi.example.com
ADMIN_DOMAIN=coldfi.example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server encryption key (64 hex chars for AES-256-GCM recovery key encryption)
SERVER_ENCRYPTION_KEY=replace-with-64-hex-chars-00000000000000000000000000000000
